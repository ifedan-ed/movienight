<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
  <section id="service.movienight">
    <category id="general" label="30000">
      <group id="1" label="30010">
        <setting id="server" type="string" label="30011" help="30012">
          <level>0</level>
          <default>https://movienight.example.com</default>
          <constraints>
            <allowempty>false</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30011</heading>
          </control>
        </setting>
        <setting id="connect" type="action" label="30013" help="30014">
          <level>0</level>
          <data>RunScript(service.movienight)</data>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="button" format="action">
            <close>true</close>
          </control>
        </setting>
      </group>
      <group id="2" label="30020">
        <!-- Percent of a video that must have played before it counts as
             watched and is reported (50-100, default 85). Anything shorter
             than 5 minutes is never reported (movienight.MIN_LENGTH).
             Listed in Movie Night's docs/limits.md. -->
        <setting id="threshold" type="integer" label="30021" help="30022">
          <level>0</level>
          <default>85</default>
          <constraints>
            <minimum>50</minimum>
            <step>5</step>
            <maximum>100</maximum>
          </constraints>
          <control type="slider" format="percentage">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="notify" type="boolean" label="30023">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
      </group>
      <group id="3">
        <setting id="token" type="string" label="30030">
          <level>4</level>
          <default/>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30030</heading>
          </control>
        </setting>
        <setting id="user" type="string" label="30031">
          <level>4</level>
          <default/>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30031</heading>
          </control>
        </setting>
        <setting id="account" type="string" label="30031">
          <level>4</level>
          <default/>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30031</heading>
          </control>
        </setting>
        <setting id="signed_out" type="string" label="30032">
          <level>4</level>
          <default/>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30032</heading>
          </control>
        </setting>
      </group>
    </category>
  </section>
</settings>
