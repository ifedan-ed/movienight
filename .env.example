# Movie Night settings. Copy to .env (chmod 600) and fill in. Never commit the real .env.
# Sign-in is the app's own OpenID Connect (OIDC); each person connects their
# own Jellyfin account inside the app.
# Every setting, with its default, is described in docs/configuration.md.
# The defaults in the code are placeholders; set every address and name below.
# Lines starting with "# NAME=" show a setting's default; remove the "# " to
# change it. An empty text setting (NAME=) means empty; an empty number or
# true/false stops the app from starting, so give it a value or leave the line out.

# --- Required -----------------------------------------------------------------
# Encrypts people's Jellyfin tokens. Generate once and keep it:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Postgres (docker-compose builds DATABASE_URL from this)
POSTGRES_PASSWORD=
# TMDB API key (titles, discovery, search, images): https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Your Jellyfin server: address, an API key (Dashboard -> API Keys), and the id
# of a user who sees every library (reads the library for everyone). If that
# user's library read fails or comes back incomplete or empty, nothing is
# removed and admins see why in Profile (docs/limits.md).
JELLYFIN_BASE_URL=https://jellyfin.example.com
JELLYFIN_PUBLIC_URL=https://jellyfin.example.com
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=
# The address Movie Night is served at (links in emails and player callbacks)
PUBLIC_URL=https://movienight.example.com
# Your sign-in username; this person is the Movie Night admin
OWNER_USERNAME=
# Background jobs, Home's morning/noon/night rows, digests and a watch date
# without a time use this zone
TIMEZONE=America/New_York

# --- Optional -----------------------------------------------------------------
# Seerr (Jellyseerr/Overseerr) for requests. Each person's requests are made
# as their own Seerr user, created from their Jellyfin account.
SEERR_BASE_URL=
SEERR_API_KEY=
# MDBList (optional): list explorer, Rotten Tomatoes/Metacritic/Letterboxd/
# Trakt scores, search fallback. No allowance of Movie Night's own
# (MDBLIST_DAILY_BUDGET is gone; delete it). MDBList's own free plan allows
# 1,000 requests a day: when it refuses, or is down, followed lists and kept
# scores stay as they are, title pages say so, and admins see it in Profile.
MDBLIST_API_KEY=
# IMDb's own ratings, from IMDb's free daily file (loaded each night)
IMDB_RATINGS_ENABLED=true
# true: search, Home, Discover and lists leave out the titles TMDB marks adult (pornography)
HIDE_ADULT_TITLES=false
# AI picks and the digest wording: any OpenAI-compatible endpoint and model.
# On when LITELLM_API_KEY and LITELLM_MODEL are both set.
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=
LITELLM_MODEL=
# Output tokens a reply may use (reasoning models need room to think)
# LITELLM_MAX_TOKENS=8000
# Weekly digest, month in review and year in review by email (empty SMTP_HOST:
# no emails). Everyone with an email address gets them unless they switch
# them off (Profile, Emails, or the link in every digest); an empty one
# (nothing watched or new) is never sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Movie Night <movienight@example.com>
# Tries at one person's digest of one period when the mail server clearly
# fails; then it is given up on (an ERROR in the log). A send whose fate is
# unknown counts as sent and is never repeated.
# DIGEST_SEND_TRIES=3
# Jellyfin Webhook plugin -> instant plays, and the Movie Night plugin for
# Jellyfin -> progress (both send it as the X-MovieNight-Token header). Empty:
# both are refused (503).
JELLYFIN_WEBHOOK_SECRET=
# One person with two sign-in accounts: other=main
USER_ALIASES=
# Extra admins besides the owner (comma separated)
ADMIN_USERS=
# Local development and tests only: while AUTH_DEV_ALLOWED is set, a caller
# signs in as the user in X-Dev-User, or AUTH_DEV_USER when no header is sent.
# Never on a server others can reach.
# AUTH_DEV_ALLOWED=false
# AUTH_DEV_USER=
#
# --- Sign-in with a username and password ---------------------------------------
# A /signin form (shown with the OIDC button when OIDC below is set up too).
# Make accounts with: docker compose exec web python -m app.cli user add NAME
# PASSWORD_SIGNIN=false
# PASSWORD_MIN_LENGTH=10

# --- Sign-in with OIDC (the app's own sign-in) ----------------------------------
# The browser signs in at the provider and Movie Night keeps its own signed
# session. The old forward-auth proxy header path (AUTH_*/TRUSTED_PROXIES/
# MOVIENIGHT_PROXY_SECRET) was removed with this switch (2026-10-16).
# Set OIDC_ISSUER and OIDC_CLIENT_ID (and the secret) and Movie Night does the
# OIDC login itself: it redirects to the provider, reads the ID token and keeps
# its own signed session. Leave these empty for no native OIDC (tokens still
# work). Register the callback on the provider:
#   {PUBLIC_URL}/api/v1/auth/oidc/callback   (or set OIDC_REDIRECT_URL)
# OIDC_ISSUER=https://sso.example.com/application/o/movienight/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile
# OIDC_REDIRECT_URL=
# OIDC_BUTTON_LABEL=Sign in
# OIDC_USERNAME_CLAIM=          # empty: preferred_username, then the email's local part
# OIDC_SESSION_DAYS=30
# Security measures, not usage limits (docs/limits.md, "Technical limits"):
# a phone's or TV's sign-in runs out after DEVICE_IDLE_DAYS unused and
# DEVICE_MAX_DAYS after it signed in; TV pairing allows PAIR_STARTS_PER_ADDRESS
# new codes per address in 10 minutes and PAIR_CODES_WAITING waiting at once.
# DEVICE_IDLE_DAYS=90
# DEVICE_MAX_DAYS=365
# PAIR_STARTS_PER_ADDRESS=10
# PAIR_CODES_WAITING=200
# How long a comment or list description, and a search, may be (longer is
# refused in plain words; not usage limits)
# TEXT_MAX_CHARS=5000
# SEARCH_MAX_CHARS=200
# ... a name a person types (a list's, a player's), what a player or the
# Jellyfin plugin reports (a title, a device), and items in one call
# NAME_MAX_CHARS=300
# REPORTED_MAX_CHARS=500
# BATCH_MAX_ITEMS=1000
# Local development only: act as this username when no header is sent.
# Never set it on a server reachable from outside.
# AUTH_DEV_USER=
# TMDB's language for titles and plots, and the country for "where to watch"
# TMDB_LANGUAGE=en-US
# WATCH_REGION=US

# --- Search -------------------------------------------------------------------
# MEILI_MASTER_KEY is given to the Meilisearch container; MEILI_API_KEY is what
# Movie Night sends. Movie Night creates and configures its indexes, so the
# simplest is the same value in both.
MEILI_BASE_URL=http://meilisearch:7700
MEILI_API_KEY=
MEILI_MASTER_KEY=
MEILI_EMBEDDER_MODEL=BAAI/bge-base-en-v1.5
MEILI_SEMANTIC_RATIO=0.8
# The most matches one search pages through in a section ("Show more"); set
# on Meilisearch's indexes at each library sync. Hitting it is said in plain words.
# SEARCH_MAX_HITS=1000
# The last page of one search (page N reads TMDB's search pages 1 to N, so a
# deep one costs up to 2 x N TMDB calls; at most 500). Said in plain words.
# SEARCH_MAX_PAGES=25
# The search catalog: every TMDB title with at least this many votes, rebuilt
# every Sunday (about 4,000 TMDB calls)
# CATALOG_ENABLED=true
# CATALOG_MOVIE_MIN_VOTES=5
# CATALOG_TV_MIN_VOTES=5

# --- Behaviour ----------------------------------------------------------------
# true: Request buttons simulate and nothing reaches Seerr
DRY_RUN=false
# "Picked for you" rows are rebuilt once this many hours old, or after this
# many new watches. These model calls have no allowance; a failed rebuild
# waits 10 minutes (doubling, at most 6 hours) and Home says so.
AI_ROWS_CACHE_TTL_HOURS=24
# AI_REFRESH_AFTER_WATCHES=3
# What "Picked for you" reads of a person (to fit the model's context window;
# the first row says what was read): latest films and best ratings, comments
# AI_PROMPT_TITLES=60
# AI_PROMPT_COMMENTS=20
# ... and how much of each comment (a longer one is shortened, and the row says how many were)
# AI_PROMPT_COMMENT_CHARS=300
# Phone app: also accept Expo Go's exp:// sign-in address (development only)
APP_DEV_REDIRECTS=false
# Search: an AI reads a described plot and names the film (off while empty;
# also needs LITELLM_API_KEY). E.g. ds-deepseek-v4.1-flash. The website and
# the phone ask it only when a search has 4 or more words and no title
# matched (the API itself doesn't check); a real answer is cached a day, a
# failed or empty one a minute. No cap on how often it is asked
# (SEARCH_AI_DAILY_LIMIT is gone; delete it).
SEARCH_AI_MODEL=
# Output tokens its answer may use (a reasoning model thinks within them;
# when it runs out, "Best guess" says so)
# SEARCH_AI_MAX_TOKENS=1500
# false: no background jobs at all (one-off scripts, tests)
# RUN_JOBS=true

# --- Docker (read by docker-compose.yml) ---------------------------------------
# External network for an optional AI container. Create it before starting:
#   docker network create movienight-ai
AI_NETWORK_NAME=movienight-ai
# Each container's log is rotated: at most LOG_MAX_FILES files of LOG_MAX_SIZE.
# The logs name nobody (numeric ids only) and hold no search text or titles.
# LOG_MAX_SIZE=10m
# LOG_MAX_FILES=5
